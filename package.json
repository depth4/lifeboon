{
  "name": "lifeboon",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A city simulator built one mechanic at a time. Real map data comes later, and only as instructions to a builder that already works.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx game/test/isolation.ts && tsx game/test/ground.test.ts"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "polygon-clipping": "^0.15.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
